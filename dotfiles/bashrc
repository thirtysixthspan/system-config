for file in ~/.{path,prompt,aliases,exports,functions}; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# autojump command line navigation tool
[ -f /opt/homebrew/etc/profile.d/autojump.sh ] && . /opt/homebrew/etc/profile.d/autojump.sh

# Node Version Manager
[[ -s "$HOME/.nvm/nvm.sh" ]] && source "$HOME/.nvm/nvm.sh"
unset NVM_NODEJS_ORG_MIRROR
unset NVM_IOJS_ORG_MIRROR

# use brew
PATH="/opt/homebrew/bin:/opt/homebrew/opt/grep/libexec/gnubin:$PATH"

export TERM=xterm

export PATH=/Users/ashmorgan/.local/bin:$PATH

# opencode
export PATH=/Users/ashmorgan/.opencode/bin:$PATH

# opengrep
export PATH=/Users/ashmorgan/.opengrep/cli/latest:$PATH



